[Unit]
Description=w4d5 веб-интерфейс исследователя и цикл сводок (127.0.0.1:8799)
After=network-online.target w4d5-mcp.service
Wants=network-online.target w4d5-mcp.service

[Service]
User=user
WorkingDirectory=/home/user/ai_challenge/w4d5
ExecStart=/home/user/ai_challenge/w4d5/target/release/w4d5
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
