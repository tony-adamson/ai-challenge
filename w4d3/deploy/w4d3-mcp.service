[Unit]
Description=w4d3 MCP-сервер наблюдений GitHub (127.0.0.1:8800)
After=network-online.target
Wants=network-online.target

[Service]
User=user
WorkingDirectory=/home/user/ai_challenge/w4d3
ExecStart=/home/user/ai_challenge/w4d3/target/release/w4d3 --mcp-server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
