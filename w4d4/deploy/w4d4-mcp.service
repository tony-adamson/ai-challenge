[Unit]
Description=w4d4 MCP-сервер наблюдений GitHub (127.0.0.1:8800)
After=network-online.target
Wants=network-online.target

[Service]
User=user
WorkingDirectory=/home/user/ai_challenge/w4d4
ExecStart=/home/user/ai_challenge/w4d4/target/release/w4d4 --mcp-server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
