# Скопируй в .env и подставь реальные ключи: cp .env.example .env
# .env в .gitignore и в репозиторий не попадает.

# Активный провайдер: deepseek | openrouter
LLM_PROVIDER=deepseek

# DeepSeek — основной провайдер челленджа
# Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter — подключаем, когда нужна модель другого назначения
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно: переопределить модель провайдера
# LLM_MODEL=deepseek-v4-flash

# Вторая, нерассуждающая модель через OpenRouter для сравнения в w1d3.
# Нужен OPENROUTER_API_KEY; без него сравнение идёт только на основной модели.
# SECOND_MODEL=openai/gpt-4.1-nano
