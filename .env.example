# Скопируй в .env и подставь реальные ключи: cp .env.example .env
# .env в .gitignore и в репозиторий не попадает.

# Активный провайдер: deepseek | openrouter
LLM_PROVIDER=deepseek

# DeepSeek — основной провайдер челленджа
# Ключ: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter — подключаем, когда нужна модель другого назначения
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно: переопределить модель провайдера
# LLM_MODEL=deepseek-v4-flash

# Вторая, нерассуждающая модель через OpenRouter для сравнения в w1d3.
# Нужен OPENROUTER_API_KEY; без него сравнение идёт только на основной модели.
# SECOND_MODEL=openai/gpt-4.1-nano

# Anthropic — второй провайдер в w1d4 (переключатель модели в панели).
# Ключ: https://console.anthropic.com/settings/keys
# По умолчанию claude-sonnet-4-6: Sonnet 5 отклоняет temperature (400).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Сравнение моделей в w1d5 идёт только через OpenRouter (нужен
# OPENROUTER_API_KEY выше). Список колонок — две тройки «слабая / средняя /
# сильная»: линейка одного вендора и кросс-вендорная. Переменную можно не
# задавать, значение ниже и есть значение по умолчанию.
# MODELS=qwen/qwen3.8-flash,qwen/qwen3.8-27b,qwen/qwen3.8-max,google/gemma-3-12b-it,deepseek/deepseek-v4-flash,anthropic/claude-sonnet-5

# Cerebras (w2d1): https://cloud.cerebras.ai — ключ API
CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# w4d3: вход в веб-интерфейс по TOTP. Секрет: cd w4d3 && cargo run -- --totp-init
TOTP_SECRET=
# w4d3: сводка наблюдений в Telegram (бот от @BotFather, chat_id — через getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# w4d3, необязательно: интервал сводки в минутах, адрес MCP-сервера
# наблюдений и адрес веб-интерфейса. Ниже — значения по умолчанию.
# SUMMARY_EVERY_MINUTES=60
# WATCH_MCP_URL=http://127.0.0.1:8800/mcp
# BIND_ADDR=127.0.0.1:8799
